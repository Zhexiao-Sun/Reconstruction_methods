RECONSTRUCTION_ROOT=/openbayes/home/Reconstruction_methods
RUNTIME_ROOT=/openbayes/home/Reconstruction_methods/runtime/requests

# 强制离线：禁止访问 huggingface.co / modelscope.cn  # 关键：避免网络超时导致推理失败
OFFLINE_MODE=1

# HuggingFace cache（建议挂载到大盘）
HF_HOME=/openbayes/home/.cache/huggingface
TRANSFORMERS_CACHE=/openbayes/home/.cache/huggingface/transformers
HF_HUB_DIR=/openbayes/home/huggingface/hub

# torch.hub cache（DINOv2 会用到；离线部署必须预先填充）  # 关键：避免 torch.hub 下载
# 注意：这里应指向 ".../.torch/hub"（你机器现有缓存也在这个目录）。  # 避免误配导致重新下载
TORCH_HOME=/openbayes/home/.torch/hub

# MapAnything 本地 snapshot（可选；不填则自动从 HF_HUB_DIR 下挑一个可用 snapshot）
# MAP_LOCAL_SNAPSHOT=/openbayes/home/huggingface/hub/models--facebook--map-anything/snapshots/e473303329ff0630b2162abb26790df26c0ec0db

# Wan 默认参数（与你常用命令对齐：--no-cpu-offload --cfg-merge --no-vae-tiling）
WAN_CPU_OFFLOAD=0
WAN_CFG_MERGE=1
WAN_VAE_TILING=0
WAN_NUM_INFERENCE_STEPS=50

# Wan 权重目录（你将 Wan-AI/Wan2.1* 与 Wan-AI/Wan2.2* 放到 input0）  # 关键：避免占用工作目录磁盘
WAN_MODELS_DIR=/openbayes/input/input0/DiffSynth-Studio/models

# MapAnything（固定抽 9 帧）
MAP_NUM_FRAMES=9


